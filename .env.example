# Copy to .env. Never commit real values.

# demo | live
OKX_ENV=demo

# Required for DEMO/LIVE execution. Leave empty for public data-only experiments.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Must be YES to send live (non-demo) orders.
CONFIRM_LIVE=NO

TRADER_ID=TRADER-001
ACCOUNT_ID=OKX-001
NODE_NAME=OKX-NODE-001

# SWAP | SPOT
OKX_INSTRUMENT_TYPE=SWAP
OKX_SYMBOL=BTC-USDT-SWAP
OKX_MARGIN_MODE=CROSS

# GLOBAL | EEA | US
OKX_REGION=GLOBAL

CATALOG_PATH=./catalog
LOG_DIR=./logs

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ENABLED=false
