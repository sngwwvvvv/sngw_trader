# Copy to .env. Never commit real values.

# demo | live
OKX_ENV=demo

# Required for DEMO/LIVE execution. Leave empty for public data-only experiments.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Must be YES to send live (non-demo) orders.
CONFIRM_LIVE=NO

TRADER_ID=TRADER-001
ACCOUNT_ID=OKX-001
NODE_NAME=OKX-NODE-001

# SWAP | SPOT
OKX_INSTRUMENT_TYPE=SWAP
OKX_SYMBOL=BTC-USDT-SWAP
OKX_MARGIN_MODE=CROSS

# GLOBAL | EEA | US
OKX_REGION=GLOBAL

CATALOG_PATH=./catalog
LOG_DIR=./logs

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ENABLED=false

# Backtest execution model
# OKX SWAP standard tier: maker 0.02% / taker 0.05% (spot: 0.0008 / 0.0010)
BT_MAKER_FEE=0.0002
BT_TAKER_FEE=0.0005
# One-way order latency in ms (100 = VPS near OKX, 200+ = home connection)
BT_LATENCY_MS=200
BT_PROB_FILL_ON_LIMIT=0.7
BT_PROB_SLIPPAGE=0.1
